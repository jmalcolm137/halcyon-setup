diff --git a/tests/plan-test.cpp b/tests/plan-test.cpp
index 31716db..cf0f58c 100644
--- a/tests/plan-test.cpp
+++ b/tests/plan-test.cpp
@@ -68,6 +68,15 @@ int main()
