+            "/usr/bin/pkexec"sv,
+            "/usr/bin/mount.nfs"sv,
+            "/usr/bin/unix_chkpwd"sv,
+            "/usr/bin/ksu"sv,
+            "/usr/bin/crontab"sv,
+            "/usr/bin/fusermount3"sv,
+            "/usr/lib/ssh-keysign"sv,
+            "/usr/lib/libgtop_server2"sv,
+            "/usr/bin/mount"sv,
+            "/usr/bin/umount"sv,
+            "/usr/lib/qemu-bridge-helper"sv,
+            "/usr/lib/dbus-daemon-launch-helper"sv,
+            "/usr/bin/doas"sv,
+            "/usr/bin/chage"sv,
+            "/usr/bin/chfn"sv,
+            "/usr/bin/chsh"sv,
+            "/usr/bin/expiry"sv,
+            "/usr/bin/gpasswd"sv,
+            "/usr/bin/newgidmap"sv,
+            "/usr/bin/newuidmap"sv,
+            "/usr/bin/newgrp"sv,
+            "/usr/bin/passwd"sv,
+            "/usr/bin/sg"sv,
